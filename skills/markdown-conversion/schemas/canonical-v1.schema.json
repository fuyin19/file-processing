{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://file-processing.local/schemas/canonical-v1.schema.json",
  "title": "file-processing Canonical Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "source", "document", "adapter", "source_units",
    "content", "tables", "assets", "relationships", "quality", "outputs"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z]+-[0-9a-f]{16}$"},
    "locator": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": true
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "content_loss"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "content_loss": {"type": "boolean"},
        "source_unit": {"type": "string"}
      }
    },
    "textFields": {
      "type": "object",
      "required": ["raw_text", "text", "normalized_text"],
      "properties": {
        "raw_text": {"type": "string"},
        "text": {"type": "string"},
        "normalized_text": {"type": "string"}
      }
    },
    "cell": {
      "allOf": [
        {"$ref": "#/$defs/textFields"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_text", "text", "normalized_text", "rowspan", "colspan"],
          "properties": {
            "raw_text": {"type": "string"},
            "text": {"type": "string"},
            "normalized_text": {"type": "string"},
            "value": {"type": ["number", "string", "null"]},
            "rowspan": {"type": "integer", "minimum": 1},
            "colspan": {"type": "integer", "minimum": 1}
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "file_name", "locator", "sha256", "hash_basis"],
      "properties": {
        "kind": {"enum": ["file", "url"]},
        "file_name": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "hash_basis": {"enum": ["source_bytes", "adapter_text"]},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "media_type": {"type": ["string", "null"]}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "title", "conversion_timestamp", "language_normalization"],
      "properties": {
        "document_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "title": {"type": "string", "minLength": 1},
        "conversion_timestamp": {"type": "string", "minLength": 1},
        "language_normalization": {"enum": ["simplified", "preserve", "traditional"]}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "limitations"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "source_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "index", "locator", "status", "warnings"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "type": {"enum": ["document", "page", "slide", "sheet"]},
          "index": {"type": "integer", "minimum": 1},
          "locator": {"$ref": "#/$defs/locator"},
          "status": {"enum": ["complete", "warning", "ocr_required", "empty"]},
          "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}
        }
      }
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "source_locator"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "type": {"enum": ["heading", "paragraph", "list_item", "code", "boilerplate", "page_label", "table", "image"]},
          "source_locator": {"$ref": "#/$defs/locator"},
          "raw_text": {"type": "string"},
          "text": {"type": "string"},
          "normalized_text": {"type": "string"},
          "level": {"type": "integer", "minimum": 1, "maximum": 6},
          "ordered": {"type": "boolean"},
          "ordinal": {"type": "integer", "minimum": 1},
          "language": {"type": "string"},
          "table_id": {"$ref": "#/$defs/id"},
          "asset_id": {"$ref": "#/$defs/id"}
        }
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["table_id", "source_locator", "raw_rows", "rows", "confidence", "warnings"],
        "properties": {
          "table_id": {"$ref": "#/$defs/id"},
          "source_locator": {"$ref": "#/$defs/locator"},
          "raw_rows": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
          "rows": {"type": "array", "items": {"type": "array", "items": {"$ref": "#/$defs/cell"}}},
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
          "caption": {"type": "string"},
          "headers": {"type": "array", "items": {"type": "string"}},
          "unit": {"type": "string"},
          "currency": {"type": "string"},
          "period": {"type": "string"},
          "footnotes": {"type": "array", "items": {"type": "string"}},
          "cross_page_continuation": {"type": "boolean"}
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "type", "path", "sha256", "media_type", "source_locator", "alt", "caption"],
        "properties": {
          "asset_id": {"$ref": "#/$defs/id"},
          "type": {"const": "image"},
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "media_type": {"type": "string", "minLength": 1},
          "source_locator": {"$ref": "#/$defs/locator"},
          "alt": {"type": "string"},
          "caption": {"type": "string"}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {"type": "object", "minProperties": 2, "additionalProperties": true}
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "warnings"],
      "properties": {
        "status": {"enum": ["complete", "complete_with_warnings", "partial"]},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "markdown", "assets"],
      "properties": {
        "mode": {"enum": ["bundle", "markdown"]},
        "markdown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
          }
        }
      }
    }
  }
}
